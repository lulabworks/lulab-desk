# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase.
# Per GitHub Actions configura gli stessi nomi come repository secrets.
# Questi due valori sono destinati al client web. Non usare mai service_role o secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
